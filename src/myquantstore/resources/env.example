# Copier ce fichier en .env et remplir avec votre clé API Massive.com
# La clé n'est JAMAIS commitée — .env est dans .gitignore
# Ou : myquantstore setup-key  /  myquantstore setup-key --api-key KEY

# Clé API Massive.com (obligatoire pour le track 1min)
MASSIVE_API_KEY=

# URL de base de l'API (optionnel — défaut: https://api.massive.com)
MASSIVE_BASE_URL=https://api.massive.com
